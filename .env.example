# =============================================================================
# OSTAN ENTERPRISE ENVIRONMENT EXAMPLE CONFIGURATION
# =============================================================================

# PostgreSQL Database Connection
DATABASE_URL="postgresql://user:password@localhost:5432/ostan_db?schema=public"

# Auth & Session Secrets
AUTH_SECRET="your_custom_jwt_secret_32_characters_long_key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Firebase Cloud Integration
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourActualApiKeyFromFirebaseConsole"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"
